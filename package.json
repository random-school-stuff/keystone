{
	"name": "keystone",
	"version": "1.0.0",
	"private": true,
	"description": "Keystone - a self-hosted web proxy with three selectable engines (Scramjet, Ultraviolet, Keystone) and Wisp",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:site": "node scripts/build-site.mjs",
		"build:logo": "node scripts/build-logo.mjs",
		"start": "node src/index.js",
		"dev": "node src/index.js"
	},
	"keywords": [
		"proxy",
		"scramjet",
		"ultraviolet",
		"wisp"
	],
	"license": "AGPL-3.0-or-later",
	"dependencies": {
		"@mercuryworkshop/bare-mux": "^2.1.9",
		"@mercuryworkshop/epoxy-transport": "2.1.29",
		"@mercuryworkshop/libcurl-transport": "^2.0.6",
		"@mercuryworkshop/scramjet": "^1.1.0",
		"@mercuryworkshop/wisp-js": "0.5.1",
		"@titaniumnetwork-dev/ultraviolet": "^3.2.10",
		"express": "^5.2.1"
	}
}
